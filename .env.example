# Real-time collaboration (experimental). When enabled, notes that are shared and unencrypted use Yjs for live multi-user editing. Requires that the server be running the Hocuspocus collab endpoint at /_ws/collab/.
NEXT_PUBLIC_COLLAB_ENABLED=false

# Real-time collaboration HA / multi-replica (optional)
# When COLLAB_REDIS_URL is set, Hocuspocus uses Redis pub/sub to share Y.Doc updates across server replicas.
# Format: redis://[:password@]host[:port]
# COLLAB_REDIS_URL=redis://localhost:6379
# COLLAB_REDIS_INSTANCE_NAME=jotty-replica-1
